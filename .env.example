# ============================================
# 果核AI（开源版）- 环境变量配置（可选）
# ============================================
# 使用说明：
# 此文件为可选配置。大多数情况下你不需要创建 .env.local 文件。
#
# API Key 通过网站前端输入，保存在浏览器本地，不需要写在这里。
# 默认使用 DeepSeek，前端可切换为其他 OpenAI 兼容 API。
#
# 以下配置仅用于服务端默认值（通常无需修改）：

# ---------- API 服务端默认配置（可选） ----------
# API Base URL（默认 DeepSeek，可改为其他 OpenAI 兼容地址）
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# 模型名称（默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# ---------- 服务器配置（可选） ----------
# 服务端口号（默认 3000）
PORT=3000
